{
  "AppName": "flotilla-backend",
  "Redis": {
    "UseRedis": true,
    "Port": 10000,
    "UseSsl": true,
    "InstanceName": "FlotillaCache"
  },
  "AzureAd": {
    "TenantId": "3aa4a235-b6e2-48d5-9195-7fcf05b459b0",
    "Instance": "https://login.microsoftonline.com",
    "AllowUsingClientSecret": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Api": "Information",
      "Hangfire": "Information",
      "System.Net": "Warning"
    }
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "Username": "flotilla",
    "Topics": [
      "isar/+/status",
      "isar/+/robot_info",
      "isar/+/startup",
      "isar/+/mission/+",
      "isar/+/task/+",
      "isar/+/battery",
      "isar/+/pressure",
      "isar/+/pose",
      "isar/+/cloud_health",
      "isar/+/media_config",
      "isar/+/intervention_needed",
      "isar/+/aborted_mission",
      "sara/visualization_available",
      "sara/analysis_result_available"
    ],
    "MaxRetryAttempts": 5,
    "ShouldFailOnMaxRetries": false,
    "AllowInsecureLocalConnections": false
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "https://*.equinor.com/"
  ],
  "Database": {
    "InitializeInMemDb": false,
    "SeedExampleDataPostgres": false,
    "Timeout": 30,
    "ConnectionResiliency": {
      "TcpKeepAlive": true,
      "KeepAlive": 30,
      "ConnectionIdleLifetime": 60,
      "ConnectionPruningInterval": 10
    }
  },
  "KeyVault": {
    "UseKeyVault": true
  },
  "BackendBaseRoute": "",
  "TimeRangeForMissionDurationEstimationInDays": 30,
  "TeamsNotification": {
    "Destinations": {
      "SystemAlerts": {
        "WebhookUrl": "Fill in ASP.NET Secret Manager"
      },
      "Feedback": {
        "WebhookUrl": "Fill in ASP.NET Secret Manager"
      }
    }
  }
}
