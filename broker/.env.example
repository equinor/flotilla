# Written by ../setup.sh, which generates throwaway local credentials.
# PEM values are the base64 body on a single line: docker compose reads this
# file through env_file, which cannot hold a multi-line value.
TLS_SERVER_KEY=
TLS_SERVER_CERT=
TLS_CA_CERT=
# Comma separated user:password pairs, one for every user in
# mosquitto/config/access_control.
MQTT_PASSWORDS=
# Set to true to run the broker without TLS. Local development only.
MQTT_ALLOW_INSECURE_LOCAL_CONNECTIONS=
