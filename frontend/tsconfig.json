{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "bundler", // Required by react-router v8+ (uses package.json exports fields). "bundler" is the correct mode for Vite projects and avoids needing file extensions on relative imports.
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "api/*": ["./src/api/*"],
      "components/*": ["./src/components/*"],
      "language": ["./src/language"],
      "language/*": ["./src/language/*"],
      "mediaAssets/*": ["./src/mediaAssets/*"],
      "models/*": ["./src/models/*"],
      "utils/*": ["./src/utils/*"],
      "config": ["./src/config"],
      "pages/*": ["./src/pages/*"],
      "hooks/*": ["./src/hooks/*"],
      "contexts/*": ["./src/contexts/*"]
    },
    "outDir": "out",
    "sourceMap": true
  },
  "include": ["src", "tests"]
}
